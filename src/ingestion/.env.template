
# Environment Variables 


# API AUTHENTICATION
# Get KEYs from : https://data.cityofchicago.org/
CHICAGO_DATA_API_KEY_ID=your_api_key_id_here
CHICAGO_DATA_API_SECRET=your_api_secret_here


# AZURE DATA LAKE STORAGE CONFIGURATION
# Get these from your Azure Storage Account in Azure Portal
AZURE_STORAGE_ACCOUNT_NAME=your_storage_account_name_here
AZURE_STORAGE_SAS_KEY=your_sas_key_here

# API ENDPOINTS

# Crime Incidents 
CHICAGO_CRIMES_API_URL=https://data.cityofchicago.org/resource/ijzp-q8t2.json

# Arrests
CHICAGO_ARRESTS_API_URL=https://data.cityofchicago.org/resource/dpt3-jri9.json

# Disadvantaged Areas
CHICAGO_DISADVANTAGED_AREAS_API_URL=https://data.cityofchicago.org/resource/2ui7-wiq8.geojson

# Socioeconomic Indicators 
CHICAGO_SOCIOECONOMIC_INDICATORS_API_URL=https://data.cityofchicago.org/resource/kn9c-c2s2.json


# AZURE DATA LAKE STORAGE 
AZURE_FILESYSTEM_NAME=crime-data-lake
AZURE_DIRECTORY_NAME=raw-data


# OPTIONAL CONFIGURATION
# API Request Settings
API_REQUEST_TIMEOUT=30
API_REQUEST_DELAY=2
MAX_RECORDS_PER_REQUEST=1000

# Data Processing Settings
BATCH_SIZE=1000
ENABLE_LOGGING=true
LOG_LEVEL=INFO


